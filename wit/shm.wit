package test:shm;

// this only works as a host provided interface, it can't be composed,
// defining it in this WIT is just because of tool compatibilty
interface exchange {
    resource address;

    type bytes = u32;
    record initialized-region {
        start: bytes,
        end: bytes,
    }
    record memory-area {
        addr: address,
        size: bytes,
    }
    flags attach-options {
        // attach memory in write mode (exclusive operation)
        write,
        // write: the data inside this buffer can be read multiple times without breaking ownership semantics
        shared,
        // extension: wait for the buffer to become available (write: empty, read: filled)
        // better handled by streams/futures?
        // block,
    }
    enum error {
        // no storage provided for attach
        no-storage,
        // non-blocking and no data (read) or no room (write) left
        busy,
        // add-storage rejects a too small buffer
        wrong-size,
        // somehow the host decided that it isn't possible to mmap
        internal,
        // the handle only grants read access: attach with `write`, or a
        // write partition requested from a read-only handle
        read-only,
        // create-partition: the range overlaps a live partition of the same block
        overlap,
        // create-partition: start+size exceeds the block, or size is 0
        out-of-range,
    }
    resource memory-block {
        // construct a memory buffer by size, the handle has read-write rights
        constructor(size: bytes);

        // only useful for shared buffers
        // the clone keeps the rights (read-write or read-only) of this handle
        // and shares the attach state (busy) with it
        clone: func() -> memory-block;
        
        // all non-static member functions implicitely borrow a 
        // memory object as the first argument

        // attach memory buffer into linear memory
        attach: func(opt: attach-options) -> result<memory-area, error>;
        // detach buffer, consumed bytes have been written/read
        detach: func(consumed: bytes);

        // pre-allocate position inside linear memory:
        // get recommended allocation size for this object
        // (this adds machine specific alignment padding)
        minimum-size: func() -> bytes;
        // pre-allocate position inside linear memory:
        // get recommended allocation size for a set of attachments 
        // (can be attached simultaneously up to count)
        optimum-size: static func(count: u32, size: bytes) -> bytes;
        // buffers need a position in linear memory to attach to, 
        // this function provides a pre-allocated area,
        // the area should be at least "minimum-size" big
        add-storage: static func(buffer: memory-area) -> result<_, error>;

        // call on parent to hand out the sub-range [start, start+size) as a
        // memory-block of its own, typically used by shm management components.
        // - mode containing `write` requests a read-write partition, otherwise
        //   it is read-only (`shared` has no meaning here). A read-only handle
        //   can only create read-only partitions (error `read-only`).
        // - partitions of the same block (created through any of its clones)
        //   are siblings and must not overlap while live (error `overlap`).
        //   A partition is live until its last handle (including clones of it)
        //   is dropped, then the range is free again. To share a range hand
        //   out clones of the partition instead of overlapping partitions.
        // - the range must be inside the block and not empty (`out-of-range`).
        // - a partition is a block of its own: own size, own attach exclusion
        //   (write exclusive, read shared) and own valid/consumed bytes. Its
        //   data is the parent's storage, a write through the partition is
        //   visible through the parent at offset `start`.
        // - the partition keeps the parent's storage alive even if the parent
        //   handle is dropped. Partitions can be partitioned again.
        // - on wasm the host maps whole pages, so an unaligned partition also
        //   makes its neighbor bytes in these pages visible (accepted leak).
        // TODO: the parent (and its clones) can still attach the whole block
        // independent of its partitions. Handing out a partition should lock
        // the range in the parent, so that write-exclusive/read-shared also
        // applies between the parent and its partitions.
        create-partition: func(start: bytes, size: bytes, mode: attach-options) -> result<memory-block, error>;

        // optional: create a buffer local to this linear memory
        // likely superceded by create-partition (which works on wasm as well)
        create-local: static func(buffer: memory-area) -> memory-block;

        // the CM implicitely creates a destructor called "drop"
    }
}

interface pub-sub {
    use exchange.{memory-block, bytes};
    // a factory for streams
    resource subscriber {
        /// subscribers receive memory handles
        get-stream: func() -> stream<memory-block>;
        /// clone
        clone: static func(original: borrow<subscriber>) -> subscriber;
    }
    resource publisher {
        /// create new data stream
        constructor(elements: u32, element-size: bytes);
        /// clone
        //clone: static func(original: borrow<publisher>) -> publisher;
        subscribers: func() -> subscriber;
        /// subscription short-cut
        get-stream: func() -> stream<memory-block>;
        /// returns a memory buffer and number of already initialized bytes 
        /// (from last write)
        allocate: func() -> tuple<memory-block, bytes>;
        /// send data to clients
        publish: func(value: memory-block);
    }
}

world impl {
    export exchange;
    export pub-sub;
}

world impl1 {
    export exchange;
}

world impl2 {
    import exchange;
    export pub-sub;
}

world client {
    import exchange;
    import pub-sub;
}

interface image {
    use exchange.{memory-block};
    increment: func(buffer: borrow<memory-block>, where: u32);
}

world plugin {
    import exchange;
    export image;
}

world main {
    import exchange;
    import image;
}
